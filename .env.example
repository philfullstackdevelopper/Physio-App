# Copiez ce fichier en .env.local et remplissez vos valeurs. Ne jamais
# committer .env.local. Sur Scalingo, les mêmes variables se règlent avec :
#   scalingo --region osc-fr1 --app easyphysio env-set NOM=valeur
# (liste à jour à l'audit du 2026-10-08 : toutes les variables lues par le code)

# --- Base de données (CLAUDE.md §7) -------------------------------------------
# PostgREST + Caddy sur Scalingo (app easyphysio-postgrest) — le client
# @supabase/supabase-js parle à cette adresse.
NEXT_PUBLIC_SUPABASE_URL=https://easyphysio-postgrest.osc-fr1.scalingo.io
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle-anon-publique
# Connexion directe, côté serveur uniquement (lib/db/admin.ts). En local, via
# `scalingo db-tunnel` (port 10002) ; sur Scalingo, l'adresse de l'addon.
SCALINGO_DATABASE_URL=postgres://utilisateur:motdepasse@127.0.0.1:10002/base
# Ancien nom accepté par scripts/migrate.mjs.
# DATABASE_URL=

# --- Stockage des vidéos d'exercices (Supabase Storage, en attendant Outscale) --
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_STORAGE_URL=https://VOTRE-PROJET.supabase.co
# Serveur uniquement — jamais NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=cle-service-role
# Outscale OOS (lib/storage/s3.ts, pas encore actif) : STORAGE_PROVIDER=s3 + clés.
# STORAGE_PROVIDER=supabase
# S3_ENDPOINT=https://oos.eu-west-2.outscale.com
# S3_REGION=eu-west-2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Connexion (Clerk) -------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Paiements (Stripe Connect) -------------------------------------------------
# Clés de TEST en développement. La clé secrète signe aussi les metadata
# (comptes Connect, abonnements) : ne jamais la changer sans y penser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Point d'envoi « Connect » (événements des comptes des kinés), s'il est séparé :
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# --- Divers -------------------------------------------------------------------
# Adresse publique du site, sans « / » final : liens d'invitation, retours
# Stripe, sitemap. À renseigner sur Scalingo.
NEXT_PUBLIC_SITE_URL=https://easyphysio.osc-fr1.scalingo.io
# E-mails autorisés dans /admin, séparés par des virgules.
ADMIN_EMAILS=vous@exemple.fr
# Annuaire Santé (vérification RPPS automatique, lib/instructor/rppsVerification.ts).
ESANTE_API_KEY=
# Fuseau horaire du serveur : déjà fixé par le Procfile et next.config.ts.
# TZ=Europe/Paris
