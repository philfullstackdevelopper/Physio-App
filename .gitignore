# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.dev-server.log
dev-server.log
fresh-dev-server.log

# scratch/debug scripts, not source
_tmp-*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code — personal local overrides, not shared with the team
/.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify — regenerated knowledge graph, not source
graphify-out/

# MCP server config — contains a live Supabase access token
.mcp.json

# subagent-driven-development scratch workspace — not source
.superpowers/
